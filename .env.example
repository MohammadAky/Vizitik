# ============================================================================
#  Vizitik - one .env for every service (backend API, admin panel, PWA build)
# ============================================================================
#  cp .env.example .env            <- once, then fill in the values
#  node scripts/env-sync.mjs       <- after every change, it distributes:
#        backend/.env        full copy   (NestJS API, Prisma CLI, admin panel)
#        frontend-app/.env   VITE_* only (the PWA build)
#  The real .env is gitignored and must never be committed.
#  Precedence: real environment (systemd/docker/shell) > root .env > app copies.
# ============================================================================

# ---------------------------------------------------------------
# database (MySQL / MariaDB)
# ---------------------------------------------------------------
# setup-server.sh builds DATABASE_URL from these (it URL-encodes the
# password). Without the setup script, encode reserved characters
# (@ : / # %) by hand in DATABASE_URL.
DB_NAME="vizitik_db"
DB_USER="vizitik"
DB_PASS="CHANGE_ME_STRONG_PASSWORD"
DB_HOST="localhost"
DATABASE_URL="mysql://vizitik:CHANGE_ME_STRONG_PASSWORD@localhost:3306/vizitik_db"

# ---------------------------------------------------------------
# backend API (NestJS)
# ---------------------------------------------------------------
PORT=3000
# 127.0.0.1 when Nginx proxies /api (recommended on a public server),
# 0.0.0.0 for docker or direct exposure.
BIND_HOST="127.0.0.1"
NODE_ENV=production
# generate:  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48
JWT_SECRET="PASTE_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="30d"

# ---------------------------------------------------------------
# branding
# ---------------------------------------------------------------
# نام نرم‌افزار ثابت و هاردکد است (ویزیتیک / Vizitik) — متغیر محیطی ندارد.
# کدها: backend/src/app.config.ts و frontend-app/src/lib/brand.js

# ---------------------------------------------------------------
# Bale bot (optional - the bot stays silent while these are empty)
# ---------------------------------------------------------------
# create the bot with @BaleChatBotBot, take the token from botfather
BALE_BOT_TOKEN=""
# public username without the @ (this project: Vizitik_bot); used for the
# profile links on every page when BALE_BOT_LINK is not set
BALE_BOT_USERNAME=""
# derived from BALE_BOT_USERNAME (https://ble.ir/<username>) unless set here
#BALE_BOT_LINK=""
# admin chat for alerts and reports. OTP codes are NOT sent here: a code that
# is not addressed to its owner is either useless or a leak
BALE_ADMIN_CHAT_ID=""
# set to 1 only while debugging signups: every OTP is then also copied to the
# admin chat
OTP_CC_ADMIN=""

# ---------------------------------------------------------------
# admin SQL panel (admin/)
# ---------------------------------------------------------------
ADMIN_PORT=3001
# the panel refuses to start without it; setup-server.sh generates one
ADMIN_TOKEN=""
# defaults keep the panel working from its own folder; on a server
# setup-server.sh writes the absolute paths in
#ADMIN_STATIC_DIR=""
#ADMIN_FONTS_DIR=""
# query kill timer, under the nginx proxy_read_timeout of 60s
ADMIN_QUERY_TIMEOUT_MS=55000

# ---------------------------------------------------------------
# PWA (frontend-app) - only VITE_* values reach the browser
# ---------------------------------------------------------------
#   /api                        same origin behind Nginx (recommended)
#   http://localhost:3000/api   local dev while the API runs elsewhere
VITE_API_URL="/api"

# ---------------------------------------------------------------
# deployment (read by scripts/setup-server.sh and scripts/update.sh)
# ---------------------------------------------------------------
INSTALL_DIR="/opt/vizitik"
BACKEND_PORT=3000
#DOMAIN="vizitik.ir"
#APP_DOMAIN="app.vizitik.ir"      # defaults to app.$DOMAIN
#ADMIN_DOMAIN="admin.vizitik.ir"  # defaults to admin.$DOMAIN
#CERT_EMAIL=""
#HTTPS_MODE=""                    # "" = HTTP-01 | "dns" = Cloudflare DNS-01
#CF_API_TOKEN=""
