# Vizitik - .env template
# Copy this file to backend/.env and fill in every value.
#   cp backend/.env.example backend/.env
# Never commit the real .env file.

# ---- database (MySQL / MariaDB) ----
# The database name is the last path segment. URL-encode the password if it
# contains reserved characters such as @ : / # %
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# ---- server ----
PORT=3000
# 127.0.0.1 when Nginx proxies /api (recommended on a public server), 0.0.0.0 for docker
BIND_HOST="127.0.0.1"
NODE_ENV=production

# ---- auth ----
# generate one with:  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48
JWT_SECRET="PASTE_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="30d"

# ---- branding ----
APP_NAME_FA="ویزیتیک"
APP_NAME_EN="Vizitik"

# ---- Bale bot (optional; the bot stays silent when these are empty) ----
# create the bot with @BaleChatBotBot / get the token from botfather, then:
BALE_BOT_TOKEN=""
BALE_BOT_USERNAME=""
# BALE_BOT_LINK is derived from BALE_BOT_USERNAME (https://ble.ir/<username>) unless set here
# BALE_BOT_LINK=""
# admin chat for alerts and reports. OTP codes are NOT sent here: a code that is
# not addressed to its owner is either useless or a leak (see OTP_CC_ADMIN below)
BALE_ADMIN_CHAT_ID=""
# set to 1 only while debugging signups: every OTP is then also copied to the admin chat
OTP_CC_ADMIN=""
