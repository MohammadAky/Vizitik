# ═══════════════════════════════════════════════════════════════
# ویزیتیک — نمونهٔ فایل .env
# ═══════════════════════════════════════════════════════════════
# این فایل را به‌صورت backend/.env کپی کن و مقادیر را پر کن.
#   cp .env.example .env

# ───────────────────────────────────────────────────────────────
# اتصال دیتابیس (MySQL / MariaDB)
# ───────────────────────────────────────────────────────────────
# نام دیتابیس «آخرین بخش قبل از ?» است — هر نامی می‌توانی بگذاری و
# در ادامه‌اش همان را بساز/ایمپورت کن (مثلاً جای vizitik_db هر نامی بگذار):
#   DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/نام_دیتابیس"
DATABASE_URL="mysql://vizitik:CHANGE_ME_PASSWORD@localhost:3306/vizitik_db"

# ───────────────────────────────────────────────────────────────
# نام نرم‌افزار / برند
#   اگر بعداً خواستی نام نرم‌افزار را عوض کنی، فقط این دو خط را تغییر بده؛
#   نام جدید در پیام‌های بله، خوش‌آمد و غیره اعمال می‌شود.
# ───────────────────────────────────────────────────────────────
APP_NAME_FA="ویزیتیک"
APP_NAME_EN="Vizitik"

# نام‌کاربری ربات بله و لینک آن (در صورت تغییر ربات، این‌ها را هم عوض کن)
BALE_BOT_USERNAME="VizitikBot"
# BALE_BOT_LINK="https://ble.ir/VizitikBot"   # (اختیاری — به‌صورت خودکار از روی USERNAME ساخته می‌شود)

# ───────────────────────────────────────────────────────────────
# توکن ربات بله (جایگزین کن)
# ───────────────────────────────────────────────────────────────
BALE_BOT_TOKEN="2089208057:mqfJ2g1Vbxn-gdtP7e3Lm6T24ou6WK0CuFc"
BALE_ADMIN_CHAT_ID="542633638"

# ───────────────────────────────────────────────────────────────
# امنیت و پورت
# ───────────────────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_to_a_long_random_secret"
JWT_EXPIRES_IN="30d"
PORT=3000
