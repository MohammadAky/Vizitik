# ============================================================
#  backend/.gitignore
# ============================================================
#  The root .gitignore already covers the shared rules (node_modules,
#  .env*, logs, IDE/OS files). This file only adds backend-specific
#  entries so the folder still behaves if it is worked on standalone.
#  NOTE: package-lock.json IS tracked (reproducible `npm ci` on the server).
#  `prisma/schema.prisma` is always tracked; the generated Prisma client
#  lives in node_modules/ and is ignored with it.

# Secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# Build output (nest build)
dist/

# Logs
logs/
*.log

# Caches & coverage
.cache/
coverage/
*.tsbuildinfo
