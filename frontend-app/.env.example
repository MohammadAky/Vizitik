# ─────────────────────────────────────────────────────────────
# ویزیتیک PWA — نمونهٔ .env  (کپی کن به frontend-app/.env)
# نام نرم‌افزار «ویزیتیک» ثابت است و از .env خوانده نمی‌شود.
# ─────────────────────────────────────────────────────────────

# آدرس API بک‌اند. در دیپلوی واقعی (Nginx ریورس‌پروکسی) خالی بگذار
# تا از مسیر نسبی /api استفاده شود. در توسعه روی localhost بگذار:
# VITE_API_URL="http://localhost:3000/api"
VITE_API_URL="/api"
