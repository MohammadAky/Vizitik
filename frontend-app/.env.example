# Vizitik PWA - .env template (copy to frontend-app/.env)
# Only VITE_* variables are exposed to the browser at build time.

# Backend API base path.
#   - same origin behind Nginx (recommended, keeps the offline queue working):  /api
#   - local development while the API runs elsewhere:  http://localhost:3000/api
VITE_API_URL="/api"
