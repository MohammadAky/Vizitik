# ============================================================================
#  frontend-app/.env - build-time variables for the PWA (Vite)
# ============================================================================
#  Only VITE_* values are inlined into the bundle; everything else must not
#  go here (secrets would end up in the browser).
#  The API base defaults to "/api" (same origin) - this file is therefore
#  optional. Create it only to override, e.g. for local dev:
#    VITE_API_URL="http://localhost:3000/api"
# ============================================================================
VITE_API_URL="/api"
